# ─────────────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values you want.
# The Firebase values are optional: the project config is already baked into
# `src/firebase/config.js`, so blank or missing values still give you working
# login + shared content. Fill them in only to override with a different
# Firebase project.
# ─────────────────────────────────────────────────────────────────────────

# ── Firebase — owner login (Google) + shared content (reviews, featured picks)
# 1. Create a project at https://console.firebase.google.com
# 2. Add a Web App (</>) and copy its config values below
# 3. Build → Authentication → Sign-in method → enable Google
# 4. Build → Firestore Database → Create database (production mode)
# 5. Paste the rules from firestore.rules into the Rules tab
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single Google account allowed into the developer console.
VITE_OWNER_EMAIL=thesakshamgoel@gmail.com

# ── Web3Forms — emails the contact + review forms straight to your inbox
# Get a free access key at https://web3forms.com (enter your email, copy the key).
# Blank = forms fall back to opening the visitor's own mail app (mailto).
VITE_WEB3FORMS_KEY=

# ── Deploy (GitHub Pages sets these in .github/workflows/deploy.yml)
# VITE_BASE=/TSG-Site-3D/
# VITE_SITE_URL=https://thesakshamgoel.github.io/TSG-Site-3D/
