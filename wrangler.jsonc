{
  // Cloudflare Workers deploy: serve the Vite build output as static assets.
  // Having this file stops `wrangler deploy` from trying to auto-configure the
  // project (which requires Vite 6+).
  "name": "tsgstudio",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // single-page app: unknown paths fall back to index.html
    "not_found_handling": "single-page-application"
  }
}
